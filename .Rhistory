ggplot(data=michigan) +
geom_sf(aes(fill=indicator)) +
labs(title="Michigan Counties, 2016 presidential election") +
scale_fill_manual(values = c("red", "blue"),
name= "popular vote winner")+
theme_void() +
theme(legend.position = "bottom")
maptest<-ggplot(data=michigan) +
geom_sf(aes(fill=indicator)) +
labs(title="Michigan Counties, 2016 presidential election") +
scale_fill_manual(values = c("red", "blue"),
name= "popular vote winner")+
theme_void() +
theme(legend.position = "bottom")
library(colorspace)
desaturate(maptest)
ggplot(data = michigan) +
geom_sf_pattern(
aes(fill = indicator, pattern = indicator),
pattern_density = 0.3,
pattern_spacing = 0.02,
pattern_angle = 45,
pattern_fill = "black",
pattern_colour = "black"
) +
scale_fill_manual(
values = c("red", "blue"),
name = "popular vote winner"
) +
scale_pattern_manual(
values = c("crosshatch", "none"),  # or switch based on indicator
name = "popular vote winner"
) +
labs(title = "Michigan Counties, 2016 presidential election") +
theme_void() +
theme(legend.position = "bottom")
