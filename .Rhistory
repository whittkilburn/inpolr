michigan <- michigan %>%
mutate(margin_cat = case_when(
margin >= 20 ~ "Strong R",
margin >= 10 ~ "Lean R",
margin > -10 & margin < 10 ~ "Toss-Up",
margin <= -10 & margin > -20 ~ "Lean D",
margin <= -20 ~ "Strong D"
))
ggplot(michigan) +
geom_sf(aes(fill = margin_cat)) +
scale_fill_grey(start = 0.9, end = 0.2, name = "Margin Category") +
theme_void()
